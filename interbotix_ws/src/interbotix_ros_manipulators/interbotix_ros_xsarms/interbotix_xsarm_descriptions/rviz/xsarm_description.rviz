      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: ""
  - Class: interbotix_xs_rviz/Interbotix Control Panel
    Name: Interbotix Control Panel
    RobotNameSpace: ""
